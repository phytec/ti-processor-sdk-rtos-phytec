<?xml version='1.0' encoding='UTF-8'?>
<data xmlns="urn:ietf:params:xml:ns:netconf:base:1.0">
	<x4nconf-server xmlns="http://excelfore.com/ns/excelfore-netconf-server">
		<transport>
			<tls>
				<port></port>
				<server-cert/>
				<server-key/>
				<capath/>
				<cert-to-name>
					<id/>
					<fingerprint/>
					<map-type/>
