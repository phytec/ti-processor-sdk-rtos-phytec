# ATTR 0 Device_nGnRnE
# ATTR 1 OuterWTnWA__InnerWTnWA
# ATTR 2 OuterNC__InnerNC
# ATTR 3 OuterWBWA__InnerWBWA
# ATTR 4 OuterWBnWA__InnerWBnWA
# ATTR 5 OuterWBRWA__InnerWBRWA
# ATTR 6 OuterWBWAnT__InnerWBWAnT
# ATTR 7 OuterWBnWAnT__InnerWBnWAnT

ATTR 0 DEV_nGnRnE
ATTR 1 OuterWT InnerWT
ATTR 2 OuterNC InnerNC
ATTR 3 OutWB OutWA InWB InWA
ATTR 4 OutWB OutRA InWB InRA
ATTR 5 OutWB OutRA OutWA InWB InRA InWA
ATTR 6 OutWB InWB 
ATTR 7 OutWBT OutRA InWBT InRA

# C7x L1SRAM
64E0_0000 64E0_3FFF 64E0_0000 4KB ATTRIDX2 OuterShareable R W S  #
65E0_0000 65E0_3FFF 65E0_0000 4KB ATTRIDX2 OuterShareable R W S  #
66E0_0000 66E0_3FFF 66E0_0000 4KB ATTRIDX2 OuterShareable R W S  #
67E0_0000 67E0_3FFF 67E0_0000 4KB ATTRIDX2 OuterShareable R W S  #

# C7x L2SRAM
6480_0000 6487_FFFF 6480_0000 2MB ATTRIDX2 OuterShareable R W S #
6580_0000 6587_FFFF 6580_0000 2MB ATTRIDX2 OuterShareable R W S #
6680_0000 6687_FFFF 6680_0000 2MB ATTRIDX2 OuterShareable R W S #
6780_0000 6787_FFFF 6780_0000 2MB ATTRIDX2 OuterShareable R W S #

# AW (MSMC-1) SRAM  (3MB each)
6800_0000 682F_FFFF 6800_0000 2MB ATTRIDX2 OuterShareable R W S #
6900_0000 692F_FFFF 6900_0000 2MB ATTRIDX2 OuterShareable R W S #
6A00_0000 6A2F_FFFF 6A00_0000 2MB ATTRIDX2 OuterShareable R W S #
6B00_0000 6B2F_FFFF 6B00_0000 2MB ATTRIDX2 OuterShareable R W S #

# MSMC-2 MMR (configuration)
6C80_0000 6C9F_FFFF 6C80_0000 2MB ATTRIDX0 OuterShareable R W S #

# MSMC-3 SRAM 8MB
7000_0000 707F_FFFF 7000_0000 2MB ATTRIDX5 OuterShareable R W S


# DDR - Code/Data
# map 32-bit VA to 36-bit PA
# relocation error in linking when using 36-bit PA directly
# 8000_0000 87FF_FFFF 8_8000_0000 2MB ATTRIDX5 OuterShareable R W S
# 8800_0000 8FFF_FFFF 8_8800_0000 2MB ATTRIDX5 OuterShareable R W S
# 9000_0000 97FF_FFFF 8_9000_0000 2MB ATTRIDX5 OuterShareable R W S
# 9800_0000 9FFF_FFFF 8_9800_0000 2MB ATTRIDX5 OuterShareable R W S
8000_0000 87FF_FFFF 8000_0000 2MB ATTRIDX2 OuterShareable R W S
8800_0000 8FFF_FFFF 8800_0000 2MB ATTRIDX2 OuterShareable R W S
9000_0000 97FF_FFFF 9000_0000 2MB ATTRIDX2 OuterShareable R W S
9800_0000 9FFF_FFFF 9800_0000 2MB ATTRIDX2 OuterShareable R W S

# for integration, L4Scratch buffer and heap region map to upper address
# E000_0000 FFFF_FFFF B_E000_0000 2MB ATTRIDX5 NonShareable R W S
# no DRU MMU case
B_E000_0000 B_FFFF_FFFF B_E000_0000 2MB ATTRIDX5 NonShareable R W S

# 8000_0000 87FF_FFFF 0:8000_0000 2MB ATTRIDX5 OuterShareable R W  S  # DDR0 Address Space c7x_0
# # 8F00_0000 8FFF_FFFF 0:8F00_0000 2MB ATTRIDX2 OuterShareable R W  S  # DDR0 Address Space c7x_0
# D5A0_0000 DFFF_FFFF 0:D5A0_0000 2MB ATTRIDX5 OuterShareable R W  S  # DDR0 Address Space c7x_1
